            "dataType": "double",
            "sourceColumn": "RecommendedRetailPrice"
          },
          {
            "name": "TypicalWeightPerUnit",
            "dataType": "double",
            "sourceColumn": "TypicalWeightPerUnit"
          },
          {
            "name": "ValidFrom",
            "dataType": "dateTime",
            "sourceColumn": "ValidFrom"
          },
          {
            "name": "ValidTo",
            "dataType": "dateTime",
            "sourceColumn": "ValidTo"
          },
          {
            "type": "calculated",
            "name": "StorageType",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "    IF ( 'StockMart vDimStockItem'[IsChillerStock], \"Chiller\", \"Dry\" )"
          },
          {
            "type": "calculated",
            "name": "PriceBrand",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "   SWITCH ( TRUE (), 'StockMart vDimStockItem'[UnitPrice] >= 100, \"High\", 'StockMart vDimStockItem'[UnitPrice] >= 20, \"Medium\", \"Low\" )"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/localhost;WideWorldImportersDW\",",
                "    StockMart_vDimStockItem = Source{[Schema=\"StockMart\",Item=\"vDimStockItem\"]}[Data]",
                "in",
                "    StockMart_vDimStockItem"
              ]
            }
          }
        ],
        "hierarchies": [
          {
            "name": "Stock Item Hierarchy",
            "levels": [
              {
                "name": "StorageType",
                "ordinal": 0,
                "column": "StorageType"
              },
              {
                "name": "PriceBrand",
                "ordinal": 1,
                "column": "PriceBrand"
              },
              {
                "name": "StockItem",
                "ordinal": 2,
                "column": "StockItem"
              }
            ]
