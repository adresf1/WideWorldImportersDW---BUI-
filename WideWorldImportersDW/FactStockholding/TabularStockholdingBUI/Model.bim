        ]
      },
      {
        "name": "StockMart vFactStockHolding",
        "columns": [
          {
            "name": "StockHoldingKey",
            "dataType": "int64",
            "sourceColumn": "StockHoldingKey"
          },
          {
            "name": "StockItemKey",
            "dataType": "int64",
            "sourceColumn": "StockItemKey"
          },
          {
            "name": "QuantityOnHand",
            "dataType": "int64",
            "sourceColumn": "QuantityOnHand"
          },
          {
            "name": "BinLocation",
            "dataType": "string",
            "sourceColumn": "BinLocation"
          },
          {
            "name": "LastStocktakeQuantity",
            "dataType": "int64",
            "sourceColumn": "LastStocktakeQuantity"
          },
          {
            "name": "LastCostPrice",
            "dataType": "double",
            "sourceColumn": "LastCostPrice"
          },
          {
            "name": "ReorderLevel",
            "dataType": "int64",
            "sourceColumn": "ReorderLevel"
          },
          {
            "name": "TargetStockLevel",
            "dataType": "int64",
            "sourceColumn": "TargetStockLevel"
          },
          {
            "type": "calculated",
            "name": "NeedsReorder",
            "dataType": "string",
            "isDataTypeInferred": true,
            "expression": "   IF ( 'StockMart vFactStockHolding'[QuantityOnHand] <= 'StockMart vFactStockHolding'[ReorderLevel], \"Yes\", \"No\" )"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/localhost;WideWorldImportersDW\",",
                "    StockMart_vFactStockHolding = Source{[Schema=\"StockMart\",Item=\"vFactStockHolding\"]}[Data]",
                "in",
                "    StockMart_vFactStockHolding"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Quantity On Hand",
            "expression": " SUM ( 'StockMart vFactStockHolding'[QuantityOnHand] )"
          },
          {
            "name": "Total Target Stock Level",
            "expression": " SUM ( 'StockMart vFactStockHolding'[TargetStockLevel] )"
          },
          {
            "name": "Stock Value",
            "expression": " SUMX ( 'StockMart vFactStockHolding', 'StockMart vFactStockHolding'[QuantityOnHand] * 'StockMart vFactStockHolding'[LastCostPrice] )"
          },
          {
            "name": "Items Needing Reorder",
            "expression": " COUNTROWS ( FILTER ( 'StockMart vFactStockHolding', 'StockMart vFactStockHolding'[QuantityOnHand] <= 'StockMart vFactStockHolding'[ReorderLevel] ) )"
          },
          {
            "name": "Items Out Of Stock",
            "expression": " COUNTROWS ( FILTER ( 'StockMart vFactStockHolding', 'StockMart vFactStockHolding'[QuantityOnHand] <= 0 ) )"
          },
          {
            "name": "Shortage To Target",
            "expression": " SUMX ( 'StockMart vFactStockHolding', MAX ( 0, 'StockMart vFactStockHolding'[TargetStockLevel] - 'StockMart vFactStockHolding'[QuantityOnHand] ) )"
          },
          {
            "name": "Overstock Quantity",
            "expression": " SUMX ( 'StockMart vFactStockHolding', MAX ( 0, 'StockMart vFactStockHolding'[QuantityOnHand] - 'StockMart vFactStockHolding'[TargetStockLevel] ) )"
          },
          {
            "name": "Items Overstocked",
            "expression": " COUNTROWS ( FILTER ( 'StockMart vFactStockHolding', 'StockMart vFactStockHolding'[QuantityOnHand] > 'StockMart vFactStockHolding'[TargetStockLevel] ) )"
          },
          {
            "name": "Margin Per Unit",
            "expression": " AVERAGEX ( 'StockMart vFactStockHolding', RELATED ( 'StockMart vDimStockItem'[UnitPrice] ) - 'StockMart vFactStockHolding'[LastCostPrice] )"
          },
          {
            "name": "Margin %",
            "expression": " DIVIDE ( [Margin Per Unit], AVERAGEX ( 'StockMart vFactStockHolding', RELATED ( 'StockMart vDimStockItem'[UnitPrice] ) ) )"
          },
          {
            "name": "High Value Low Stock Items",
            "expression": " CALCULATE ( [Items Needing Reorder], 'StockMart vDimStockItem'[Price Band] = \"High\" )"
          },
          {
            "name": "Chiller Stock Value",
            "expression": " CALCULATE ( [Stock Value], 'StockMart vDimStockItem'[IsChillerStock] = TRUE () )"
          },
          {
            "name": "Chiller Share %",
            "expression": " DIVIDE ( [Chiller Stock Value], [Stock Value] )"
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "f572de24-19f4-45ec-b80a-a8b52ece186b",
        "fromTable": "StockMart vFactStockHolding",
