            "sourceColumn": "Supplier Invoice Number"
          },
          {
            "name": "Total Excluding Tax",
            "dataType": "double",
            "sourceColumn": "Total Excluding Tax"
          },
          {
            "name": "Tax Amount",
            "dataType": "double",
            "sourceColumn": "Tax Amount"
          },
          {
            "name": "Total Including Tax",
            "dataType": "double",
            "sourceColumn": "Total Including Tax"
          },
          {
            "name": "Outstanding Balance",
            "dataType": "double",
            "sourceColumn": "Outstanding Balance"
          },
          {
            "name": "Is Finalized",
            "dataType": "boolean",
            "sourceColumn": "Is Finalized"
          }
        ],
        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/localhost;WideWorldImportersDW\",",
                "    TransactionMart_FactTransaction = Source{[Schema=\"TransactionMart\",Item=\"FactTransaction\"]}[Data]",
                "in",
                "    TransactionMart_FactTransaction"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Customer Payments",
            "expression": [
              "",
              "    -CALCULATE(",
              "        SUM('TransactionMart FactTransaction'[Total Including Tax]),",
              "        'TransactionMart DimTransactionType'[Transaction Type Key] = 3",
              "    )"
            ]
          },
          {
            "name": "Customer Outstanding Balance",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('TransactionMart FactTransaction'[Outstanding Balance]),",
              "    'TransactionMart DimTransactionType'[Transaction Type Key] = 1,",
              "    'TransactionMart FactTransaction'[Outstanding Balance] > 0",
              ")"
            ]
          },
          {
            "name": "Total Outstanding Balance",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('TransactionMart FactTransaction'[Outstanding Balance]),",
              "    'TransactionMart FactTransaction'[Outstanding Balance] > 0",
              ")"
            ]
          },
          {
            "name": "Payment Transaction Count",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('TransactionMart FactTransaction'),",
              "    'TransactionMart DimTransactionType'[Transaction Type Key]",
              "        IN {3, 7}",
              ")"
            ]
          },
          {
            "name": "Non-Finalized Customer Transactions",
            "expression": [
              "",
              "CALCULATE(",
              "    COUNTROWS('TransactionMart FactTransaction'),",
              "    'TransactionMart FactTransaction'[Is Finalized] = FALSE(),",
              "    'TransactionMart DimTransactionType'[Transaction Type Key]",
              "        IN {1, 2, 3, 4}",
              ")"
            ]
          },
          {
            "name": "Total Supplier Payments",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('TransactionMart FactTransaction'[Total Including Tax]),",
              "    'TransactionMart DimTransactionType'[Transaction Type Key] = 7",
              ") * -1"
            ]
          },
          {
            "name": "Supplier Outstanding Balance",
            "expression": [
              "",
              "CALCULATE(",
              "    SUM('TransactionMart FactTransaction'[Outstanding Balance]),",
              "    'TransactionMart DimTransactionType'[Transaction Type Key] = 5,",
              "    'TransactionMart FactTransaction'[Outstanding Balance] > 0",
              ")"
            ]
          }
        ]
      }
    ],
